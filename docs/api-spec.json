{
  "openapi": "3.0.3",
  "info": {
    "title": "DevOnboard API",
    "description": "Local web-backed codebase institutional-memory API for scan, history ingest, graph retrieval, cited answers, evidence packs, and app result runs.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/scan": {
      "post": {
        "summary": "Start repository structure scan",
        "operationId": "postScan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Scan started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/scan/status": {
      "get": {
        "summary": "Get structure scan status",
        "operationId": "getScanStatus",
        "responses": {
          "200": {
            "description": "Current scan progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ingest/history": {
      "post": {
        "summary": "Start git and GitHub history ingest",
        "operationId": "postIngestHistory",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestHistoryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "History ingest started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/ingest/history/status": {
      "get": {
        "summary": "Get history ingest status",
        "operationId": "getIngestHistoryStatus",
        "responses": {
          "200": {
            "description": "Current history ingest progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "summary": "Submit a cited onboarding or refactor-risk query",
        "operationId": "postQuery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query response with citations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/APIError"
          },
          "422": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/graph": {
      "get": {
        "summary": "Get the inspectable knowledge graph",
        "operationId": "getGraph",
        "responses": {
          "200": {
            "description": "Knowledge graph",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeGraph"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/graph/node/{id}/history": {
      "get": {
        "summary": "Get History/Why evidence for a graph node",
        "operationId": "getGraphNodeHistory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Node history and rationale evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeHistory"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/evidence-packs": {
      "post": {
        "summary": "Create a cited PR review or AI-agent context pack",
        "operationId": "postEvidencePack",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidencePackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copyable evidence pack",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePack"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/APIError"
          },
          "422": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/results": {
      "post": {
        "summary": "Run fixed app result measurement",
        "operationId": "postResults",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Result run started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRunStarted"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/results/runs": {
      "get": {
        "summary": "List saved result runs",
        "operationId": "getResultRuns",
        "responses": {
          "200": {
            "description": "Saved result runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultRun"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/results/runs/{run_id}": {
      "get": {
        "summary": "Get a saved result run",
        "operationId": "getResultRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRun"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/APIError"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "APIError": {
        "description": "Structured API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      }
    },
    "schemas": {
      "APIError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "nullable": true
              }
            }
          }
        }
      },
      "ScanRequest": {
        "type": "object",
        "required": ["repo_path"],
        "properties": {
          "repo_path": {
            "type": "string",
            "description": "Local repository path or public HTTPS GitHub URL."
          },
          "branch": {
            "type": "string",
            "default": "dev"
          },
          "commit": {
            "type": "string",
            "nullable": true
          },
          "exclude_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "IngestHistoryRequest": {
        "type": "object",
        "properties": {
          "repo_path": {
            "type": "string",
            "description": "Optional local repository path or public HTTPS GitHub URL selected in the frontend. Falls back to graph repo URL/path, then TARGET_REPO_PATH."
          },
          "branch": {
            "type": "string",
            "default": "dev"
          },
          "commit": {
            "type": "string",
            "nullable": true
          },
          "max_commits": {
            "type": "integer",
            "default": 500
          },
          "include_pr_comments": {
            "type": "boolean",
            "default": true
          },
          "allow_external_llm_for_private_repo": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "required": ["status", "progress"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["idle", "running", "done", "partial", "error"]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "QueryMode": {
        "type": "string",
        "enum": ["auto", "structural", "historical", "hybrid"],
        "default": "auto"
      },
      "Route": {
        "type": "string",
        "enum": ["structural", "historical", "hybrid"]
      },
      "QueryRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "$ref": "#/components/schemas/QueryMode"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_external_llm_for_private_repo": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "required": ["answer", "route", "citations", "retrieval_ms", "synthesis_ms"],
        "properties": {
          "answer": {
            "type": "string"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "structural": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "historical": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_ms": {
            "type": "integer"
          },
          "synthesis_ms": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer",
            "nullable": true
          },
          "evidence_only": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Evidence": {
        "type": "object",
        "required": ["node_id", "type", "label", "summary"],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["file", "function", "class", "module", "service", "endpoint", "config", "domain", "flow", "step", "commit", "pr", "issue", "review", "claim", "entity", "topic"]
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "KnowledgeGraph": {
        "type": "object",
        "required": ["version", "generated_at", "repo", "nodes", "edges"],
        "properties": {
          "version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "repo": {
            "type": "object"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "result_runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultRunSummary"
            }
          }
        }
      },
      "ResultRunSummary": {
        "type": "object",
        "required": ["run_id", "created_at"],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NodeHistory": {
        "type": "object",
        "required": ["node_id", "evidence", "claims"],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EvidencePackRequest": {
        "type": "object",
        "required": ["purpose"],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["pr_review", "ai_agent_context"]
          },
          "query": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changed_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_external_llm_for_private_repo": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "EvidencePack": {
        "type": "object",
        "required": ["purpose", "markdown", "citations", "warnings", "excluded_sources"],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["pr_review", "ai_agent_context"]
          },
          "markdown": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_only": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ResultRequest": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "target_branch": {
            "type": "string",
            "default": "dev"
          },
          "target_commit": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ResultRunStarted": {
        "type": "object",
        "required": ["run_id", "status"],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["running"]
          }
        }
      },
      "ResultRun": {
        "type": "object",
        "required": ["run_id", "repo", "target_branch", "rows", "created_at"],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "target_branch": {
            "type": "string"
          },
          "target_commit": {
            "type": "string",
            "nullable": true
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricRow"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetricRow": {
        "type": "object",
        "required": ["query_id", "query_text", "time_to_useful_answer_ms", "citations_count", "evidence_count", "warnings_count"],
        "properties": {
          "query_id": {
            "type": "integer"
          },
          "query_text": {
            "type": "string"
          },
          "time_to_useful_answer_ms": {
            "type": "integer"
          },
          "citations_count": {
            "type": "integer"
          },
          "evidence_count": {
            "type": "integer"
          },
          "warnings_count": {
            "type": "integer",
          },
          "evidence_usefulness_score": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 5,
            "description": "Computed score from evidence coverage, direct citations, evidence diversity, and unsupported-claim warnings."
          },
          "human_quality_score": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 5,
            "description": "Manual evaluator rating."
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string"
          },
          "graph_exists": {
            "type": "boolean"
          },
          "qdrant": {
            "type": "boolean"
          },
          "llm_available": {
            "type": "boolean"
          },
          "target_repo": {
            "type": "object",
            "description": "Configured non-secret target repository context."
          },
          "graph_repo": {
            "type": "object",
            "nullable": true,
            "description": "Repository context persisted in the current knowledge graph, if any."
          }
        }
      }
    }
  }
}
