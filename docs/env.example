# DevOnboard — environment variables
# Copy to .env and fill in your values

# --- Gemini API (required) ---
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: gemini-2.0-flash 15 RPM / embedding-004 1500 RPM
GEMINI_API_KEY=

# --- GitHub API token (optional but recommended) ---
# Without token: 60 req/hr (enough for ingest)
# With token: 5000 req/hr
# Scopes needed: public_repo (read-only)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=goclaw_history

# --- CodeGraph ---
# Path to the cloned goclaw repo (relative to backend/)
CODEGRAPH_REPO_PATH=../target_repo

# --- Target repo ---
TARGET_REPO_URL=https://github.com/nextlevelbuilder/goclaw
TARGET_REPO_BRANCH=dev

# --- Ingest settings ---
INGEST_MAX_COMMITS=500
INGEST_BATCH_SIZE=50       # Gemini embedding batch size

# --- Rate limiting ---
# Delay between Gemini API calls (ms) to stay within free tier
GEMINI_DELAY_MS=2000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
