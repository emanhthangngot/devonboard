# DevOnboard — environment variables
# Copy to .env and fill in your values

# --- Gemini API (required) ---
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: gemini-2.0-flash 15 RPM / embedding-004 1500 RPM
GEMINI_API_KEY=

# Gemini model config (free tier mid-2026)
GEMINI_SYNTHESIS_MODEL=gemini-2.5-flash
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite

# --- GitHub API token (optional but recommended) ---
# Without token: 60 req/hr (enough for ingest)
# With token: 5000 req/hr
# Scopes needed: public_repo (read-only)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=goclaw_history

# --- Graph input ---
# Paths are relative to the repository root when using the local web app.
TARGET_REPO_PATH=./target_repo
DEVONBOARD_GRAPH_PATH=./devonboard/knowledge-graph.json
DEVONBOARD_REPO_CACHE_PATH=./devonboard/repos
DEVONBOARD_RESULTS_DIR=./devonboard/results

# --- Target repo ---
TARGET_REPO_URL=https://github.com/nextlevelbuilder/goclaw
TARGET_REPO_BRANCH=dev
TARGET_REPO_COMMIT=

# --- Data handling ---
# Keep false for private/proprietary repositories unless the owner explicitly
# allows retrieved source snippets to be sent to the configured LLM provider.
ALLOW_EXTERNAL_LLM_FOR_PRIVATE_REPO=false
EXCLUDE_PATTERNS=.env*,node_modules/**,vendor/**,dist/**,build/**,.git/**

# --- Ingest settings ---
MAX_COMMITS_INGEST=500
INGEST_BATCH_SIZE=50       # Gemini embedding batch size

# --- Rate limiting ---
# Delay between Gemini API calls (ms) to stay within free tier
GEMINI_DELAY_MS=2000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
